extend class DeltaPlayer
{
	protected bool isUsingOffhand;
	protected string offhandIcon;
	protected double offhandTpCost;
	protected double preOffhandTp;	// used for refunding TP if offhand fails
	protected int preOffhandTpTimer;
	
	private TextureID _offhandIconId;
	
	virtual void CheckUseOffhand()
	{
		if (!(player.cmd.buttons & BT_USER1))
			return;
		if (!CanUseOffhand())
			return;
		
		TryStartOffhand();
	}
	
	virtual bool TryStartOffhand()
	{
		preOffhandTp = tensionPoints;
		preOffhandTpTimer = tensionDrainTimer;
		
		if (!TryTakeTension(offhandTpCost))
			return false;
		
		StartOffhand();
		return true;
	}
	
	virtual void StartOffhand()
	{
		isUsingOffhand = true;
		A_Overlay(PSP_WEAPON, "Null");
		A_Overlay(PSP_OFFHAND, "OffhandOverlay");
		
		let psp = player.FindPSprite(PSP_OFFHAND);
		if (psp)
			psp.Tick();
		
		A_OverlayFlags(PSP_OFFHAND, PSPF_ADDBOB, true);
		A_OverlayFlags(PSP_OFFHAND, PSPF_ADDWEAPON, false);
		A_OverlayOffset(PSP_OFFHAND, 0, 32);
	}
	
	// Wrap up
	action void A_EndOffhand()
	{
		invoker.isUsingOffhand = false;
		A_OverlayOffset(PSP_WEAPON, 0, WEAPONBOTTOM);
		
		let weap = player.ReadyWeapon,
			psp = player.GetPSprite(PSP_WEAPON);
		
		if (weap)
			psp.SetState(weap.GetUpState());
	}
	
	clearscope virtual bool CanUseOffhand()
	{
		return !GetIsUsingOffhand();
	}
	
	clearscope bool GetIsUsingOffhand()
	{
		return isUsingOffhand;
	}
	
	clearscope TextureID GetOffhandIconID()
	{
		return _offhandIconId;
	}
}