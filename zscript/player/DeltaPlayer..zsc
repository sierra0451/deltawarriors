	{
		DELTA_XHR_NEUTRAL,
		DELTA_XHR_FRIENDLY,
		DELTA_XHR_ENEMY
	}
	enum DeltaCrouchState
	{
		CS_STANDING,
		CS_CROUCHING,
		CS_SLAMMING,
		CS_SLIDING
	}
