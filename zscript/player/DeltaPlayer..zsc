	{
		PSP_LEGS = -100,
		PSP_OFFHAND = -50
	}
	enum HeartbeatSetting
	{
		HB_OFF,
		HB_ON,
		HB_LIGHTNERS_ONLY
	}
	enum DeltaRecoilType
	{
		RECOIL_LAND,
		RECOIL_WEAPON,
		RECOIL_DAMAGE
	}
	enum DeltaWeaponAnimType
	{
		DELTA_WEAPONANIM_MELEE,
		DELTA_WEAPONANIM_GUN,
		DELTA_WEAPONANIM_MAGIC
	}
	enum DeltaFootstepType
	{
		FOOTSTEP_NONE,
		FOOTSTEP_BOOTS,
		FOOTSTEP_FLUFF,
		FOOTSTEP_HOOVES
	}
	enum DeltaVoicePriority
	{
		VOX_LEAST_IMPORTANT = -1,	// overriden by anything, overrides nothing
		VOX_BREATHING = 0,
		VOX_MOVEMENT = 10,			// jump/landing grunts, etc.
		VOX_PAIN = 20,				// damage grunts
		VOX_DIALOGUE = 30,			// dialogue for taunts, story, etc.
		VOX_DEATH = 40,				// shut the character the fuck up if they die
		VOX_MOST_IMPORTANT			// overrides all default voice priorities
	}
	
	const COYOTE_TIME = 3;
	const JUMP_BUFFER_TIME = 3;
	const ANIM_GROUNDED_HANG_TIME = 3;
	const MAX_AIR_BOB_TICS = 7;
	const DELTA_AIR_CONTROL = 0.4;
	const DAMAGE_IFRAMES = 10;
	const DRAIN_TIMER_START = TICRATE * 12;			// tp lasts for 12 seconds before we start draining it
	const DRAIN_AMOUNT = 5./TICRATE;
	const DRAIN_GRACE_TICS = 3;						// if we try to call for TP and it's drained below what we need for only a few ticks, let us use it anyway
	const MAX_GRAZE_TICS = 5;
	const DEFAULT_RED_CROSSHAIR_RANGE = 500.;
	const MAX_TURN = 10;
	const DEATH_HANG_FRAMES = TICRATE;
	
	double tensionPoints, maxTensionPoints, bobTimer;
	int grazeTics, tensionDrainTimer, hugReactionTime;
	bool beingHugged, canRespawn;
	
	protected int coyoteTimer; 						// used to handle coyote time
	protected int jumpBuffer, airBobTics, hugTimer;
	protected double customBobPerc;
	protected int damageTics; 						// invulnerability frames, essentially
	protected int lastDamageTaken;
	protected int deathTimer; 						// used for first person death animation
	protected double deathPitchFP, deathPitchTP;
	protected DeltaCrouchState crouchState;
	
	protected double flinchMultiplier;				// wanna be able to make certain characters flinch more or flinch less at incoming damage
	protected int startFlinchTics;
	protected int shakinessMaxHealth;				// lowest possible health where we'll still be at minimum hand shakiness
	protected double minShakiness, maxShakiness;
	protected int oldShakiness;						// used for interpolation
	protected string backAtYouObituary, parryObituary;
	
	protected Array<Actor> grazed;
	
	protected string characterIcon, nameTag, automapIcon;
	protected Color characterColor, overhealColor;
	
	protected LinearValueInterpolator heartbeat, shakiness;
	protected bool didFirstDeathAnim, blind;
	
	protected double angleDiff;
	
	protected state
		SpawnGunState,				SpawnMeleeState,		SpawnMagicState,
		SeeGunState,				SeeMeleeState, 			SeeMagicState,
		PainGunState,				PainMeleeState, 		PainMagicState,
		MissileGunState,			MissileMeleeState, 		MissileMagicState,
		MissileGunNoFlashState,		FinishMissileGunState,
		AirGunState,				AirMeleeState,			AirMagicState,
		AirMissileGunState,			AirMissileMeleeState, 	AirMissileMagicState,
		AirMissileGunNoFlashState,	AirFinishMissileGunState,
		AirPainGunState,			AirPainMeleeState,		AirPainMagicState,
		AirDeathState;
	protected DeltaWeaponAnimType lastAnimType;
	
	protected string
		gunStandSprite, meleeStandSprite, magicStandSprite,
		gunCrouchSprite, meleeCrouchSprite, magicCrouchSprite;
	protected double crouchFactor;
	
	private double _targetRoll;
	private bool _frozenDeath;				// using this for custom ice death that doesn't automatically shatter us lol
	
	private Vector2 _desiredMove, _move;
	
	private Vector2 _currentFlinch;			// used for weapon flinching when taking damage
	private int _flinchTics;
	
	private Vector2 _lastBob;				// saving weapon position for hitstops or when we die
	
	private double _oldTurn, _turn;
	private double _originalHeight;			// used for fixing compatibility issues with maps (mainly Boom maps) that use voodoo doll scripting
	
	private TextureID _characterIconId;		// used for health displays in co-op and team deathmatch
	private TextureID _nameTagId;			// used for character name display in HUD
	private int _automapIcon;
	
	private DeltaCrosshairState _crosshairState;
	
	private RecoilEvent[10] _recoils;
	private double _landPunch, _deltaLandPunch;
	
	private Array<Name> _dynamicLights;
	private PlayerInfo _savedPlayer;
	private Weapon _savedPending;
	
	// Damage types that ignore I-frames.
	static const Name DAMAGE_TYPES_IGNORE_IFRAMES[] =
	{
		'Crush',
		'Telefrag',
		'Falling',
		'Suicide',
		'Exit',
		'Poison'
	};
	
	property HugReactionTime: hugReactionTime;
	property CharacterColor: characterColor;		// mostly used for hud elements
	property OverhealColor: overhealColor;			// used for overheal bar on hud
	property FlinchMultiplier: flinchMultiplier;
	property StartFlinchTics: startFlinchTics;
	property LungeSpeed: lungeSpeed;
	property OffhandIcon: offhandIcon;
	property OffhandTpCost: offhandTpCost;
	property CharacterIcon: characterIcon;
	property NameTag: nameTag;
	property AutomapIcon: automapIcon;
	property GunStandSprite: gunStandSprite;
	property MeleeStandSprite: meleeStandSprite;
	property MagicStandSprite: magicStandSprite;
	property GunCrouchSprite: gunCrouchSprite;
	property MeleeCrouchSprite: meleeCrouchSprite;
	property MagicCrouchSprite: magicCrouchSprite;
	property ShakinessMaxHealth: shakinessMaxHealth;
	property MinShakiness: minShakiness;
	property MaxShakiness: maxShakiness;
	property BackAtYouObituary: backAtYouObituary;	// used specifically if we kill by parrying a projectile back into its original owner
	property ParryObituary: parryObituary;			// used if we kill by parrying otherwise
	
	Default
	{
		Health 200;
		Player.MaxHealth 200;
		Radius 16;
		Speed 0.8;
		Mass 100;
		
		PainChance 256;
		Player.MugShotMaxHealth -1;
		
		Player.DisplayName "DeltaPlayer";
		Player.SoundClass "delta";
		Player.ViewHeight 32.0;
		
		// strafing should be same speed as moving forward
		Player.ForwardMove 1, 1;
		Player.SideMove 1.0416667, 1.25;
		
		Player.AttackZOffset 12;
		Player.JumpZ 12;
		Player.GruntSpeed 3;
		Player.ViewBob 0.3;
		Player.ViewBobSpeed 12;
		Player.FlyBob 0;
		
		DeltaPlayer.HugReactionTime 20;
		DeltaPlayer.CharacterColor Color(127, 127, 127);
		DeltaPlayer.OverhealColor Color(60, 220, 60);
		
		DeltaPlayer.FlinchMultiplier 10;
		DeltaPlayer.StartFlinchTics 5;
		DeltaPlayer.LungeSpeed 45;
		
		DeltaPlayer.OffhandIcon "";
		DeltaPlayer.OffhandTpCost 0;
		
		DeltaPlayer.CharacterIcon "";
		DeltaPlayer.NameTag "";
		DeltaPlayer.AutomapIcon "";
		DeltaPlayer.GunCrouchSprite "";
		DeltaPlayer.MeleeCrouchSprite "";
		DeltaPlayer.MagicCrouchSprite "";
		
		DeltaPlayer.ShakinessMaxHealth 80;
		DeltaPlayer.MinShakiness 0.2;
		DeltaPlayer.MaxShakiness 1;
		
		DeltaPlayer.BackAtYouObituary "$OBIT_DELTA_KPARRYBACK";
		DeltaPlayer.ParryObituary "$OBIT_DELTA_KPARRY";
		
		DeltaPlayer.FootstepType FOOTSTEP_NONE;
		DeltaPlayer.FootstepTime 10;
		DeltaPlayer.VoiceClass "";
		DeltaPlayer.JumpGruntChance 0.; // 0% chance by default, meant to get
										// people to change this
		
		+NOICEDEATH;
		+FLOORCLIP;
		+DONTGIB;
		+SQUAREPIXELS;
		+PLAYERPAWN.NOTHRUSTWHENINVUL;
	}
	
	States
	{
		Spawn:
			TNT1 A 1;
			Loop;
		See:
			TNT1 A 1;
			Loop;
	}
	
	States (Overlay)
	{
		// ====================
		//   OFFHAND OVERLAYS  
		// ====================
		OffhandOverlay:
			TNT1 A 0 A_EndOffhand;
			Stop;
		
		// ================
		//   LEG OVERLAYS
		// ================
		IdleLegs:
			TNT1 A 1;
			Loop;
		WalkLegs:
			TNT1 A 3;
			TNT1 A 2;
		WalkLoopLegs:
			TNT1 A -1;
			Loop;
		CrouchWalkLegs:
			TNT1 A 3;
			TNT1 A 2;
		CrouchWalkLoopLegs:
			TNT1 A -1;
			Loop;
		RunLegs:
			TNT1 A 3;
		RunLoopLegs:
			TNT1 A -1;
			Loop;
		AirLegs:
