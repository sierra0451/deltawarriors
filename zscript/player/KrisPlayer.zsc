class KrisPlayer : DeltaPlayer
{
	protected double
		slideAngleOffset,
		slideSpeed,					// normal slide speed
		slideAdjustSpeed,			// speed at which strafing will move you while sliding
		slideSlowing;				// time it takes sliding to slow to a stop on flat surface
	protected state
		ParryState,						ParryMissState,
		AirParryState,					AirParryMissState,
		SlideMeleeState,				SlideGunState,
		SlideMissileMeleeState, 		SlideMissileGunState,
		SlideMissileGunNoFlashState, 	SlideFinishMissileGunState,
		SlidePainMeleeState, 			SlidePainGunState,
		SlideLegsState,					StopSlideLegsState,
		FinishSlideLegsState;
	
	private double _currentSlideSpeed, _savedSlideSpeed;
	private int _savedSlideSpeedTimer;
	private bool _lastCrouchedWhileAirborne, _lastCrouchedWhileGrounded;
	private int
		_slideTics,					// used for smooth transitions into sliding effects
		_slideTime,					// used for nerfing slide spamming
		_stopSlideTicks;			// used to stop sliding if we try to slide into a wall
	private Vector3 _oldSlideVel;
    
	const MAX_SLIDE_TICS 		= 7;
	const MIN_SLIDE_TIME 		= TICRATE * 2 / 5;
	const MAX_STOP_SLIDE_TICKS	= TICRATE / 2;
	const PARRY_IFRAMES 		= 12;
	
	Default
	{
		Height 46;
		Radius 16;
		Speed 0.8;
		Mass 100;
		
		Health 200;
		Player.MaxHealth 200;
		DeltaPlayer.LevelOneHP 90;
		
		Player.DisplayName "$DELTA_CHAR_KRIS";
		Player.ViewHeight 35.0;
		
		Player.WeaponSlot 1, "KrisSword";
		Player.WeaponSlot 2, "KrisRevolver";
		Player.WeaponSlot 3, "KrisShotgun";
		Player.WeaponSlot 4, "KrisSMG";
		Player.WeaponSlot 5, "KrisGrenadeLauncher";
		Player.WeaponSlot 6, "TempIncinerator", "TempPlasmaRifle";//"KrisCrossbow";
		Player.WeaponSlot 7, "TempCalamityBlade", "TempBFG9000";
		
		Player.StartItem "KrisSword";
		Player.StartItem "KrisRevolver";
		Player.StartItem "Clip", 15;
		Player.StartItem "DeltaParryDamage"; 	// hacky af workaround for more consistent
												// projectile parry damage
		
		Player.Face "KRF";
		
		DeltaPlayer.HugReactionTime 20;
		DeltaPlayer.CharacterColor Color(0, 162, 232);
		DeltaPlayer.OffhandIcon "graphics/hud/shieldParryIcon.png";
		DeltaPlayer.OffhandTpCost floor(0.4 * 250);
		
		DeltaPlayer.CharacterIcon "graphics/krisCharIcon.png";
		DeltaPlayer.NameTag "graphics/krisNameTag.png";
		DeltaPlayer.AutomapIcon "KICN";
		
		DeltaPlayer.GunStandSprite "KRSG";
		DeltaPlayer.MeleeStandSprite "KRSW";
		DeltaPlayer.GunCrouchSprite "KCGN";
		DeltaPlayer.MeleeCrouchSprite "KCSW";
		
		DeltaPlayer.FootstepType FOOTSTEP_BOOTS;
		DeltaPlayer.VoiceClass "kris";
		DeltaPlayer.JumpGruntChance 0.6;
	}
	
	States
	{
		Spawn:
			KRSW A 1 NoDelay A_DeltaGetState("Spawn");
			Loop;
		SpawnMelee:
			#### A 1 A_UseMeleeSprite;
			Loop;
		SpawnGun:
			#### A 1 A_UseGunSprite;
			Loop;
		SeeMelee:
			#### BACA -1;
			Loop;
		SeeGun:
			#### BACA -1;
			Loop;
		AirMelee:
			KRSW JKLM 3;
			Loop;
		AirGun:
			KRSG JKLM 3;
			Loop;
		Lunge:
			KRSW D 1;
			Loop;
		MissileMelee:
			#### EEFFGGGHHH 1
			{
				A_UseMeleeSprite();
				
				if (invoker.crouchState == CS_SLIDING)
					return A_Sync(MissileMeleeState, SlideMissileMeleeState);
				
				return A_SyncIf(!invoker.IsGrounded(), MissileMeleeState, AirMissileMeleeState);
			}
			Goto SpawnMelee;
		AirMissileMelee:
			KRSW NNOOPPPQQQ 1
			{
				return A_SyncIf(invoker.IsGrounded(), AirMissileMeleeState, MissileMeleeState);
			}
			Goto AirMelee;
		MissileGun:
			#### DDDD 1
			{
				A_UseGunSprite();
				if (invoker.crouchState == CS_SLIDING)
					return A_Sync(MissileGunState, SlideMissileGunState);
				
				return A_SyncIf(!invoker.IsGrounded(), MissileGunState, AirMissileGunState);
			}
			Goto FinishMissileGun;
		MissileGunNoFlash:
			#### EEEE 1
			{
				A_UseGunSprite();
				if (invoker.crouchState == CS_SLIDING)
					return A_Sync(MissileGunNoFlashState, SlideMissileGunNoFlashState);
				
				return A_SyncIf(!invoker.IsGrounded(), MissileGunNoFlashState, AirMissileGunNoFlashState);
			}
		FinishMissileGun:
			#### EEEEEEEE 1
			{
				A_UseGunSprite();
				if (invoker.crouchState == CS_SLIDING)
					return A_Sync(FinishMissileGunState, SlideFinishMissileGunState);
				
				return A_SyncIf(!invoker.IsGrounded(), FinishMissileGunState, AirFinishMissileGunState);
			}
			Goto SpawnGun;
		AirMissileGun:
			KRSG NNNN 1
			{
				A_UseGunSprite();
				return A_SyncIf(invoker.IsGrounded(), AirMissileGunState, MissileGunState);
			}
			Goto AirFinishMissileGun;
		AirMissileGunNoFlash:
			KRSG OOOO 1
			{
				A_UseGunSprite();
				return A_SyncIf(invoker.IsGrounded(), AirMissileGunState, MissileGunState);
			}
		AirFinishMissileGun:
			KRSG OOOOOOOO 1
			{
				A_UseGunSprite();
				return A_SyncIf(invoker.IsGrounded(), AirFinishMissileGunState, FinishMissileGunState);
			}
			Goto AirGun;
		Slide:
			TNT1 A 0 A_DeltaGetState("Slide");
			Goto Spawn;
		SlideMelee:
			KSLD ABC 3;
			Loop;
		SlideGun:
			KSLG ABC 3;
			Loop;
		SlideMissileMelee:
			KSLD DDEEFFFGGG 1 A_SyncIf(invoker.crouchState != CS_SLIDING, SlideMissileMeleeState, MissileMeleeState);
			Goto SlideMelee;
		SlideMissileGun:
			KSLG EEEE 1 A_SyncIf(invoker.crouchState != CS_SLIDING, SlideMissileGunState, MissileGunState);
			Goto SlideFinishMissileGun;
		SlideMissileGunNoFlash:
			KSLG FFFF 1 A_SyncIf(invoker.crouchState != CS_SLIDING, SlideMissileGunNoFlashState, MissileGunNoFlashState);
		SlideFinishMissileGun:
			KSLG FFFFFFFF 1 A_SyncIf(invoker.crouchState != CS_SLIDING, SlideFinishMissileGunState, FinishMissileGunState);
		Pain:
			TNT1 A 1 A_DeltaGetState("Pain");
			Goto Spawn;
		PainMelee:
			KRSW IIIIIIII 1
			{
				A_UseMeleeSprite();
				
				if (invoker.crouchState == CS_SLIDING)
					return A_Sync(PainMeleeState, SlidePainMeleeState);
				
				return A_SyncIf(!invoker.IsGrounded(), PainMeleeState, AirPainMeleeState);
			}
			Goto SpawnMelee;
		PainGun:
			KRSG IIIIIIII 1
			{
				A_UseGunSprite();
				
				if (invoker.crouchState == CS_SLIDING)
					return A_Sync(PainGunState, SlidePainGunState);
				
				return A_SyncIf(!invoker.IsGrounded(), PainGunState, AirPainGunState);
			}
			Goto SpawnGun;
		AirPainMelee:
			KRSW RRRRRRRR 1
			{
				A_UseMeleeSprite();
				return A_SyncIf(invoker.IsGrounded(), AirPainMeleeState, PainMeleeState);
			}
			Goto AirMelee;
		AirPainGun:
			KRSG RRRRRRRR 1
			{
				A_UseGunSprite();
				return A_SyncIf(invoker.IsGrounded(), AirPainGunState, PainGunState);
			}
			Goto AirGun;
		SlidePainMelee:
			KSLD AAAAAAAA 1
			{
				return A_SyncIf(invoker.crouchState != CS_SLIDING, SlidePainMeleeState, PainMeleeState);
			}
			Goto SlideMelee;
		SlidePainGun:
			KSLG AAAAAAAA 1
			{
				return A_SyncIf(invoker.crouchState != CS_SLIDING, SlidePainGunState, PainGunState);
			}
			Goto SlideGun;
		Parry:
			KPRY AABBCCCCDDDD 1 A_SyncIf(!invoker.IsGrounded(), ParryState, AirParryState);
			Goto Spawn;
		AirParry:
			KPRY FFGGHHHHIIII 1 A_SyncIf(invoker.IsGrounded(), AirParryState, ParryState);
			Goto Spawn;
		ParryMiss:
			KPRY AA 1 A_SyncIf(!invoker.IsGrounded(), ParryMissState, AirParryMissState);
			Goto Parry+2;
		AirParryMiss:
			KPRY JJ 1 A_SyncIf(invoker.IsGrounded(), AirParryMissState, ParryMissState);
			Goto AirParry+2;
		Death:
			#### # 1;
			KDTH A 6;
			KDTH B 9;
			KDTH C 3;
		Death.Falling:
		Death.Crush:
		FinishDeath:
			KDTH D 3;
			KDTH E 3 A_DeathImpact;
			KDTH F 7;
			KDTH F 1 A_SpawnDeathSoul;
			KDTH F -1;
			Stop;
		AirDeath:
			KDTH GHIJK -1;
			Loop;
		
		// may come back to these at later time
		/*
		Death.Ice:
			DKRF A 2 A_DeltaFreezeDeath;
			#### BCD 2;
			Goto FinishIce;
		FinishIce:
			DKRF E GameTicRate;
			#### # 1 A_SpawnDeathSoul;
			#### # -1;
			Stop;
		*/
	}
	
	States (Overlay)
	{
		// ====================
		//   OFFHAND OVERLAYS  
		// ====================
		OffhandOverlay:
			TNT1 A 0;
		ParryOverlay:
			DKSL B 2 A_KrisShieldParry;
			DKSL C 2;
			DKSL D 4;
			DKSL E 2;
			TNT1 A 5;
			TNT1 A 0 A_EndOffhand;
			Stop;
		
		// ================
		//   LEG OVERLAYS
		// ================
		IdleLegs:
			KLEG # 1;
			Loop;
		WalkLegs:
			KLEG A 3;
			KLGW A 2;
		WalkLoopLegs:
			KLGW BCDEFGHI -1;
			Loop;
		CrouchWalkLegs:
			KLEG # 3;
			KLCW A 2;
		CrouchWalkLoopLegs:
			KLCW BCDEFGHI -1;
			Loop;
		RunLegs:
			KLEG A 3;
			KLGR A 2;
		RunLoopLegs:
			KLGR BCDEFGHIJK -1;
			Loop;
		SlideLegs:
			KRSL ABCD 1;
			Wait;
		StopSlideLegs:
			KRSL EFGH 1;
			Goto FinishSlideLegs;
		FinishSlideLegs:
			KRSL H 1;
			Goto IdleLegs;
		AirLegs:
			KLGA # 1;
			Loop;
	}
	
	override void BeginPlay()
	{
		Super.BeginPlay();
		
		ParryState 					= FindState("Parry");
		ParryMissState 				= FindState("ParryMiss");
		AirParryState 				= FindState("AirParry");
		AirParryMissState 			= FindState("AirParryMiss");
		SlideMeleeState 			= FindState("SlideMelee");
		SlideGunState 				= FindState("SlideGun");
		SlideMissileMeleeState 		= FindState("SlideMissileMelee");
		SlideMissileGunState 		= FindState("SlideMissileGun");
		SlideMissileGunNoFlashState	= FindState("SlideMissileGunNoFlash");
		SlideFinishMissileGunState 	= FindState("SlideFinishMissileGun");
		SlidePainMeleeState 		= FindState("SlidePainMelee");
		SlidePainGunState 			= FindState("SlidePainGun");
		SlideLegsState 				= FindState("SlideLegs");
		StopSlideLegsState 			= FindState("StopSlideLegs");
		FinishSlideLegsState 		= FindState("FinishSlideLegs");
	}
	
	override void PostBeginPlay()
	{
		Super.PostBeginPlay();
		
		slideSpeed = 18;
		slideAdjustSpeed = 6;
		_savedSlideSpeed = slideSpeed;
		slideSlowing = 6.6;
	}
	
	override void Travelled()
	{
		if (crouchState == CS_SLIDING)
			EndSlide();
		
		_slideTics = _slideTime = 0;
		Super.Travelled();
	}
	
	override void PlayerThink()
	{
		_oldSlideVel = vel;
		Super.PlayerThink();
		HandleSlide();
	}
	
	override void MovePlayer()
	{
		Super.MovePlayer();
		slideAngleOffset -= angleDiff;
	}
	
	override void CheckJump()
	{
		if (!level.IsJumpingAllowed() || crouchState != CS_SLIDING)
		{
			Super.CheckJump();
			return;
		}
		
		float oldVel = vel.z;
		Super.CheckJump();
		if (vel.z > oldVel && vel.z == JumpZ * 35 / GameTicRate)
			EndSlide();
	}
	
	override void CheckCrouch(bool totallyFrozen)
	{
		Super.CheckCrouch(totallyFrozen);
		
		if (!player || totallyFrozen)
			return;
		
		int buttons = player.cmd.buttons,
			crouchDir = (buttons & BT_CROUCH) ? -1 : 1;
		bool doingMoveInput = player ? (player.cmd.forwardMove || player.cmd.sideMove)
			: false;
		
		if (crouchState != CS_SLIDING && ((buttons & BT_CROUCH && !(player.oldButtons & BT_CROUCH))
			|| (crouchDir == -1 && _lastCrouchedWhileAirborne && !_lastCrouchedWhileGrounded))
			&& coyoteTimer <= COYOTE_TIME && IsCrouching())
		{
			let dir = (GetPlayerInput(INPUT_FORWARDMOVE) / 12800., GetPlayerInput(INPUT_SIDEMOVE) / 10240.);
			
			if (buttons & BT_RUN && (abs(dir.x) > 0.1 || abs(dir.y) > 0.1))
				StartSlide(-VectorAngle(dir.x, dir.y));
		}
		else if (crouchDir == -1 && crouchState == CS_SLIDING)
			CrouchMove(-2);
		else if ((crouchDir == 1 && _slideTime >= MIN_SLIDE_TIME) && crouchState == CS_SLIDING)
			EndSlide();
		
		if (coyoteTimer <= COYOTE_TIME && crouchState != CS_SLIDING && buttons & BT_CROUCH)
			_lastCrouchedWhileGrounded = true;
		else if (crouchState == CS_SLIDING || !(buttons & BT_CROUCH))
			_lastCrouchedWhileGrounded = false;
		
		if (coyoteTimer > COYOTE_TIME && crouchDir == -1)
			_lastCrouchedWhileAirborne = true;
		else if (crouchDir != -1 || !doingMoveInput || crouchState == CS_SLIDING)
			_lastCrouchedWhileAirborne = false;
	}
	
	override void DeltaUncrouch()
	{
		Super.DeltaUncrouch();
		
		if (crouchState == CS_SLIDING)
			EndSlide();
	}
	
	// make sure we're not bobbing if we're sliding
	override void CalcHeight()
	{
		let tempZ = pos.Z + ViewHeight + player.crouchViewDelta;

		if (tempZ > ceilingZ-4)
			tempZ = ceilingZ-4;
		
		Super.CalcHeight();
		
		player.viewZ = player.viewZ + (tempZ - player.viewZ) * (double(_slideTics) / MAX_SLIDE_TICS);
	}
	
	override bool CanCollideWith(Actor other, bool passive)
	{
		if (crouchState != CS_SLIDING)
			return Super.CanCollideWith(other, passive);
		
		if (other.bIsMonster && other.mass <= 200 && (!other.player || !other.player.cheats & CF_PREDICTING))
			return false;
		
		return Super.CanCollideWith(other, passive);
	}
	
	override void Step(double curVel)
	{
		if (crouchState != CS_SLIDING)
			Super.Step(curVel);
	}
	
	override void PlayerLandedMakeGruntSound(actor onmobj)
	{
		if (crouchState != CS_SLIDING)
			Super.PlayerLandedMakeGruntSound(onmobj);
	}
	
	override double GetViewRoll()
	{
		if (!_slideTics)
			return Super.GetViewRoll();
		
		double _roll = Super.GetViewRoll();
		_roll += (5. + 3. * GetPlayerInput(INPUT_SIDEMOVE) / 10240.)
			* _slideTics / MAX_SLIDE_TICS;
		
		return _roll;
	}
	
	override void HandleRalseiHugs()
	{
		Super.HandleRalseiHugs();
		
		if (beingHugged)
		{
			A_SetMugshotState("Normal");	// wanna make sure blush is ALWAYS called
			A_SetMugshotState("Blush");
		}
	}
	
	override double GetGrazeMultiplier()
	{
		let mult = Super.GetGrazeMultiplier();
		if (crouchState == CS_SLIDING)
			mult *= 0.5;
		
		return mult;
	}
	
	override void AnimateDeath()
	{
		if (!InAirDeathState())
		{
			Super.AnimateDeath();
			return;
		}
		
		int minTics = 3,
			maxTics = 15,
			targetTics = maxTics;
		
		if (abs(Vel.Z) != 0 && GetGravity() != 0)
			targetTics = clamp(int(maxTics / GetGravity() / abs(Vel.Z)), minTics, maxTics);
		
		if (tics == -1 || tics > targetTics)
			tics = targetTics;
		
		let dest = A_CheckDeathLand();
		if (dest)
			SetStateSafe(dest);
	}
	
	protected void HandleSlide()
	{
		let
			slideDir = (cos(angle + slideAngleOffset), sin(angle + slideAngleOffset)),
			slideX = slideDir.x * _currentSlideSpeed,
			slideY = slideDir.y * _currentSlideSpeed;
		
		if (crouchState == CS_SLIDING)
		{
			if (_slideTics < MAX_SLIDE_TICS)
				_slideTics++;
			
			_slideTime++;
			
			if (reactionTime)
				return;
			
			let
				sideInput = GetPlayerInput(INPUT_SIDEMOVE) / 10240.,
				speedPerc = _currentSlideSpeed / slideSpeed,
				adjustFactor = sideInput * slideAdjustSpeed * speedPerc;
			
			slideX += sin(Angle) * adjustFactor;
			slideY -= cos(Angle) * adjustFactor;
			
			if (player.cheats & CF_FROZEN)
			{
				vel = (0, 0, 0);
				return;
			}
			
			vel = (slideX, slideY, vel.z);
			
			if (IsGrounded())
			{
				let [friction, moveFactor] = GetFriction();
				let [z, sec, _3dFloor] = curSector.NextLowestFloorAt(pos.x, pos.y,
						pos.z + double.EQUAL_EPSILON, stepH: maxStepHeight);
				
				let slowFactor = friction < ORIG_FRICTION ?
						ORIG_FRICTION_FACTOR / moveFactor :
						moveFactor / ORIG_FRICTION_FACTOR,
					norm = _3dFloor? -_3dFloor.model.ceilingPlane.normal
						: sec.floorPlane.normal,
					prevSpeed = _oldSlideVel.Length(),
					realCurSpeed = vel.Length(),
					speedDiff = realCurSpeed - prevSpeed;
				
				if (norm.z < 1.0)
				{
					let cosP = norm.XY.Length(),
						r = (norm.y, -norm.x, 0) / cosP,
						dir = norm cross r,
						dProd = -((dir.z, dir.y) dot slideDir);
					
					if (dProd > 0)
						dProd *= 2;
					
					slowFactor += dProd * cosP;
				}
				
				_currentSlideSpeed -= slideSlowing * slowFactor / GameTicRate;
				
				if (speedDiff > 3. && prevSpeed < 5.)
					_stopSlideTicks++;
				else
					_stopSlideTicks = 0;
				
				if (_currentSlideSpeed < 0)
					_currentSlideSpeed = 0;
				
				speedPerc = _slideTime > 1?
					clamp((prevSpeed + speedDiff/2) / slideSpeed, 0, 1) : 1.;
				
				if (!(player.cheats & CF_CHASECAM))
				{
					let intensity = 0.5 * speedPerc;
					A_QuakeEx(0, intensity, intensity, 2, 0, 1, "dssilent",
						QF_RELATIVE|QF_GROUNDONLY);
				}
				
				if (!IsActorPlayingSound(CHAN_MOVEMENT))
					A_StartSound("delta/kris/slide_loop", CHAN_MOVEMENT,
						CHANF_LOOPING, speedPerc);
				else
					A_SoundVolume(CHAN_MOVEMENT, speedPerc);
				
				if (_currentSlideSpeed < 1 || _stopSlideTicks >= MAX_STOP_SLIDE_TICKS)
				{
					EndSlide();
					_currentSlideSpeed = 0;
					_savedSlideSpeed = slideSpeed;
				}
				else
					_savedSlideSpeed = (_currentSlideSpeed > 1)? _currentSlideSpeed : slideSpeed;
				
				_savedSlideSpeedTimer = GameTicRate / 10;
			}
			else if (IsActorPlayingSound(CHAN_MOVEMENT))
				A_StopSound(CHAN_MOVEMENT);
		}
		else
		{
			if (_slideTics > 0)
				_slideTics--;
			
			_slideTime = 0;
			if (IsActorPlayingSound(CHAN_MOVEMENT))
				A_StopSound(CHAN_MOVEMENT);
			
			if (-vel.z * 0.75 > _savedSlideSpeed)
				_savedSlideSpeed = -vel.z * 0.75;
			else
				_savedSlideSpeed = max(slideSpeed, _savedSlideSpeed - (slideSlowing / GameTicRate));
		}
		
		customBobPerc = 1 - (double(_slideTics) / MAX_SLIDE_TICS);
		customBobPerc *= customBobPerc;
	}
	
	protected void StartSlide(double angOffset, bool resetSpeed = true)
	{
		if (coyoteTimer > COYOTE_TIME || GetIsUsingOffhand())
			return;
		
		slideAngleOffset = angOffset;
		crouchState = CS_SLIDING;
		_slideTime = 0;
		_stopSlideTicks = 0;
		
		if (resetSpeed)
			_currentSlideSpeed = max(_savedSlideSpeed, vel.XY.Length());
		
		if (IsPredicting())
			return;
		
		let
			slideDir = (cos(angle + slideAngleOffset), sin(angle + slideAngleOffset)),
			slideX = slideDir.x * _currentSlideSpeed,
			slideY = slideDir.y * _currentSlideSpeed;
		vel.x = slideX;
		vel.y = slideY;
		_oldSlideVel = vel;
		
		if (!IsActorPlayingSound(CHAN_BODY, "delta/land"))
			A_StartSound("delta/kris/slide_start", CHAN_BODY);
		
		let psp = player.FindPSprite(PSP_LEGS);
		if (!psp)
			return;
		
		psp.SetState(SlideLegsState);
	}
	
	protected void EndSlide()
	{
		_slideTime = 0;
		
		// prevent legs reappearing if we stop sliding as result of death
		if (Health <= 0)
		{
			crouchState = CS_STANDING;
			return;
		}
		
		crouchState = CS_CROUCHING;
		let psp = player.FindPSprite(PSP_LEGS);
		if (!psp)
			return;
		
		psp.SetState(StopSlideLegsState);
	}
	
	protected action void A_SpawnDeathSoul(double zOffset = 36)
	{
		if (invoker.didFirstDeathAnim)
			return;
		
		invoker.didFirstDeathAnim = true;
		let soul = DeltaSoul(Spawn("DeltaSoul", Vec3Offset(0, 0, zOffset))),
			ply = invoker.GetSavedPlayer();
		
		if (ply)
			soul.playerParent = ply;
	}
	
	protected void KrisShieldParry()
	{
		A_StartSound("delta/kris/shield_swing", CHAN_AUTO);
		AddRecoil(RECOIL_WEAPON, 10, 1, p: -1, y: 5);
		
		double
			forwardDistance = 120,
			upDistance = 30,
			dotThreshold = 0.85; // dot product must be larger than this to count as parried
		
		ThinkerIterator it = ThinkerIterator.Create("Actor", STAT_DEFAULT);
		Actor mis;
		Array<Actor> parried, affected;
		
		while (mis = Actor(it.Next()))
		{
			if (!mis.CanCollideWith(self, false))
				continue;
			if (!mis.bIsMonster && mis.target && IsFriend(mis.target)) // friendly projectiles shouldn't be parried
				continue;
			if (mis.bMissile && mis.target == self) // "target" with projectiles is used to figure out who threw it
				continue;
			
			let parriable = DeltaParriable(mis.FindInventory("DeltaParriable", true));
			if (!mis.bMissile && !mis.bSkullfly && (!parriable || !parriable.CanBeParried()))
				continue;
			if (mis.curState.InStateSequence(mis.ResolveState("Death")))
				continue;
			
			double blockDist = forwardDistance + (mis.radius * 1.5);
			double blockHeight = upDistance + (mis.height * 1.5);
			Vector3 diff = level.Vec3Diff(pos.PlusZ(height/2), mis.pos);
			
			if (Distance2DSquared(mis) > blockDist*blockDist
				|| abs(diff.z) > blockHeight)
				continue;
			
			Vector3 fwd = DeltaUtil.GetActorForward(self);
			fwd = (fwd.x, fwd.y, 0);
			if (diff.Unit() dot fwd < 0.4)
				continue;
			
			parried.Push(mis);
			affected.Push(mis);
		}
		
		if (!parried.Size())
		{
			SetState(ResolveState("ParryMiss"));
			tensionDrainTimer = preOffhandTpTimer;
			tensionPoints = preOffhandTp;
			return;
		}
		
		affected.Push(self);
		
		let startHitstopTics = 7,
			hitstopTics = 7;
		
		SetState(ResolveState("Parry"));
		A_QuakeEx(0, 10, 5, 10, 0, 10, "dsilent", QF_RELATIVE | QF_SCALEDOWN);
		damageTics = PARRY_IFRAMES;
		
		foreach (parryTarget : parried)
		{
			let parryPitch = AimLineAttack(Angle, PLAYERMISSILERANGE,
					flags: ALF_CHECK3D | ALF_NOFRIENDS | ALF_NOWEAPONCHECK),
				newSpeed = parryTarget.bMissile ? 70 : 50,
				vecToAng = AngleToVector(angle, 1),
				vecToPitch = AngleToVector(parryPitch, 1),
				newVel = (vecToAng.x * vecToPitch.x, vecToAng.y * vecToPitch.x,
					-vecToPitch.y);
			
			newVel *= newSpeed;
			
			if (parryTarget.bMissile)
			{
				parryTarget.SetOrigin(
					pos + (0, 0, viewHeight) + (DeltaUtil.GetActorForward(self)*10),
					moving: false);
				let inv = DeltaParried(parryTarget.GiveInventoryType("DeltaParried"));
				inv.oldTarget = parryTarget.target;	// mostly for checking if we
													// knocked a player's own
													// projectile back at them for
													// obituaries
				if (parryTarget.target)
					affected.Push(parryTarget.target);
				
				parryTarget.target = self;
				parryTarget.tracer = null;
				parryTarget.Vel = newVel;
				parryTarget.Angle = Angle;
				parryTarget.Pitch = parryPitch;
				parryTarget.bForcePain = true;
				parryTarget.GiveInventory("DeltaNoGiveDamageTP", 1);
				
				let dmg = max(0, parryTarget.GetMissileDamage(0, 1) - 10);
				hitstopTics = clamp(startHitstopTics + int(dmg * 0.1), hitstopTics, 20);
				continue;
			}
			
			let parryDamage = int(random[parryDmg](200, 250) * max(1,
				G_SkillPropertyFloat(SKILLP_MonsterHealth)));
			
			if (parryTarget.bSkullfly)
			{
				parryTarget.DamageMobj(self, self, parryDamage, 'Parry', DMG_THRUSTLESS);
				parryTarget.Vel = newVel;
			}
			else if (parryTarget.bIsMonster)
			{
				parryTarget.DamageMobj(self, self, parryDamage, 'Parry', DMG_THRUSTLESS);
				parryTarget.TriggerPainChance('Parry', true);
				DeltaUtil.RollForParryExplosion(parryTarget);
			}
		}
		
		DeltaUtil.StartHitstop(self, affected, hitstopTics);
	}
	
	action void A_KrisShieldParry()
	{
		invoker.KrisShieldParry();
	}
	
	override void DeltaExtraDeathStuff()
	{
		Super.DeltaExtraDeathStuff();
		
		if (crouchState == CS_SLIDING)
			EndSlide();
	}
	
	void PlaySliding()
	{
		let curAnimType = DELTA_WEAPONANIM_MELEE;
		if (player.ReadyWeapon && (player.ReadyWeapon is "DeltaWeapon"))
			curAnimType = DeltaWeapon(player.ReadyWeapon).GetAnimType();
		
		if (curAnimType != lastAnimType || InSeeState() || InSpawnState() || InAirState())
			SetStateSafe(A_DeltaGetState("Slide"));
	}
	
	override void AnimatePlayer()
	{
		if (InParryState())
			return;
		
		if (crouchState == CS_SLIDING)
		{
			if (InPainState())
				SetStateSafe(A_DeltaGetState("SlidePain"));
			else
				PlaySliding();
		}
		else
		{
			if (InSlideState())
				SetStateSafe(SpawnState);
			
			Super.AnimatePlayer();
		}
	}
	
	override Vector2 GetLegsOffset()
	{
		if (!player)
			return Super.GetLegsOffset();
		
		let psp = player.FindPSprite(PSP_LEGS);
		if (!psp)
			return Super.GetLegsOffset();
		
		if (psp.curState.InStateSequence(SlideLegsState)
			|| (psp.curState.InStateSequence(StopSlideLegsState) && 
				!psp.curState.InStateSequence(FinishSlideLegsState)))
		{
			let ofs = CalculateLegsOffset(pitch + viewPitch - 29);
			ofs.x += -5.*sin(slideAngleOffset) + 0.5*GetTurn();
			return ofs;
		}
		
		return Super.GetLegsOffset();
	}
	
	clearscope bool InParryState()
	{
		return curState.InStateSequence(ParryState) ||
			curState.InStateSequence(ParryMissState) ||
			curState.InStateSequence(AirParryState) ||
			curState.InStateSequence(AirParryMissState);
	}
	
	clearscope bool InSlideState()
	{
		return CurState.InStateSequence(SlideMeleeState) ||
			CurState.InStateSequence(SlideGunState);
	}
	
	override bool InMissileState()
	{
		return Super.InMissileState() ||
			CurState.InStateSequence(SlideMissileMeleeState) ||
			CurState.InStateSequence(SlideMissileGunState) ||
			CurState.InStateSequence(SlideMissileGunNoFlashState) ||
			CurState.InStateSequence(SlideFinishMissileGunState);
	}
}