		DamageFunction random[cacoDamage](20, 30);
	}
}

/// ------------------------------------
///     HELL NOBLE REPLACEMENT STUFF    
/// ------------------------------------
class DeltaHellKnight : HellKnight replaces HellKnight
{
	Default
	{
		BloodColor "37 73 2b";
	}
	
	States
	{
		Missile:
			TNT1 A 0 A_Jump(256, "Stomp");
			BOSS E 12
			{
				A_FaceTarget();
			}
			BOSS F 8 A_FaceTarget;
			BOSS G 8 A_BruisAttack;
			Goto See;
		Stomp:
			BOSS H 4 A_ChangeVelocity(z: 4, flags: CVF_REPLACE);
			BOSS A 1 A_ChangeVelocity(z: -10, flags: CVF_REPLACE);
			BOSS A 1 A_CheckStomp;
			Goto See;
	}
	
	protected action void A_CheckStomp()
	{
		
	}
}

class DeltaBaronOfHell : BaronOfHell replaces BaronOfHell
{
	Default
	{
		Speed 10;
		BloodColor "37 73 2b";
	}
	
	States
	{
		See:
			BOSS AABBCCDD 3 A_Chase;
			Loop;
		Pain:
			TNT1 A 0 { invoker.bXFlip = false; }
			Goto Super::Pain;
		Melee:
			BOSS E 12
			{
				if (skill < SKILL_NORMAL)
					A_SetTics(18);
				
				let tele = DeltaTelegraph.SpawnTelegraph("DeltaNoParryTelegraph");
				tele.SetOrigin(invoker.pos.PlusZ(49), false);
				A_FaceTarget();
			}
			BOSS F 4 Slow A_FaceTarget;
			BOSS G 8
			{
				A_FaceTarget();
				
				if (!CheckMeleeRange())
					return ResolveState("FanPattern") + 2;
				
				A_StartSound("baron/melee", CHAN_AUTO);
				if (!invoker.target.DamageMobj(invoker, invoker, random(60, 80), "Melee"))
					return ResolveState(null);
				
				let knockbackAmt = 25.,
					ang = invoker.AngleTo(invoker.target);
				A_ChangeVelocity(cos(ang) * knockbackAmt, sin(ang) * knockbackAmt, 12., CVF_REPLACE, ptr: AAPTR_TARGET);
				return ResolveState(null);
			}
			BOSS A 4;
			Goto See;
		Missile:
			TNT1 A 0 A_Jump(256, "FanPattern", "WideSpread");
			Stop;
		FanPattern:
			BOSS E 10
			{
				invoker.bXFlip = randomPick(false, true);
				A_FaceTarget();
			}
			BOSS F 4 A_FaceTarget;
			BOSS G 2
			{
				A_FaceTarget();
				
				if (skill < SKILL_NORMAL)
					A_SpawnProjectile("BaronBall");
				else
					A_SpawnProjectile("BaronBall", angle: invoker.bXFlip? 30. : -30.);
			}
			BOSS G 2
			{
				if (skill < SKILL_NORMAL)
					return;
				
				A_SpawnProjectile("BaronBall", angle: invoker.bXFlip? 15. : -15.);
			}
			BOSS G 4
			{
				if (skill < SKILL_NORMAL)
					return;
				
				A_SpawnProjectile("BaronBall");
			}
			TNT1 A 0 { invoker.bXFlip = false; }
			Goto See;
		WideSpread:
			BOSS E 10 Slow
			{
				let tele = DeltaTelegraph.SpawnTelegraph("DeltaParryTelegraph");
				tele.SetOrigin(invoker.pos.PlusZ(49), false);
				
				let [ang, ptch] = DeltaUtil.PredictTarget(invoker, "BaronBall");
				A_SetAngle(ang);
				A_SetPitch(ptch);
			}
			BOSS E 4;
			BOSS F 6;
			BOSS G 4 Slow
			{
				A_FaceTarget();
				for (double ang = -30; ang <= 30; ang += skill < SKILL_NORMAL? 30 : 20)
					let proj = A_SpawnProjectile("BaronBall", flags: CMF_AIMOFFSET,
						angle: ang);
			}
			BOSS G 4;
			Goto See;
	}
}

class DeltaBaronBall : BaronBall replaces BaronBall
{
	Default
	{
		Speed 15;
		DamageFunction random[baronDamage](40, 50);
	}
}

