	override void InterfaceProcess(ConsoleEvent e)
	{
		if (e.IsManual)
			return;
		
		let hud = DeltaHud(statusBar);
		if (!hud)
			return;
		
		if (e.name ~== "DeltaResetHUD")
			hud.ResetHUD();
		else if (e.name ~== "DeltaPlayerDamage")
		{
			Actor source = Actor(GetNetworkEntity(e.args[0])),
				inflictor = Actor(GetNetworkEntity(e.args[1]));
			let amount = e.args[2];
			
			hud.CreateDamageIndicator(source, inflictor);
			hud.CreateDamagePopup(source, amount);
		}
		else if (e.name ~== "DeltaPlayerGraze")
		{
			let source = Actor(GetNetworkEntity(e.args[0]));
			hud.CreateGrazeIndicator(source);
		}
		else if (e.name ~== "DeltaAllPlayersDead")
		{
			bool firstTime = e.args[0];
			hud.StartDeathSequence(firstTime);
		}
		else if (e.name ~== "DeltaCancelDeathSequence")
		{
			hud.CancelDeathSequence();
		}
		else if (e.name ~== "DismissMapMessage")
		{
			hud.DismissMessage();
		}
		else if (e.name.Left(10) == "MessageIs_")
		{
			let msg = e.name.Mid(10);
			hud.AddMessage(msg);
		}
		else if (e.name ~== "DeltaSeenPlayer")
			hud.playersSeen.Push(e.args[0]);
		else if (e.name ~== "DeltaClearPlayersSeen")
			hud.playersSeen.Clear();
	}
	
	override void RenderUnderlay(RenderEvent e)
	{
		let hud = DeltaHud(statusBar);
		if (!hud)
			return;
		
		hud.pos = e.viewPos;
		hud.angles = (e.viewPitch, e.viewRoll, e.viewAngle);
		//viewPos = e.viewPos;
	}
	
	override void UiTick()
	{
		//EventHandler.SendNetworkEvent("DeltaUpdateTime", SystemTime.Now());
	}
	
	override bool InputProcess(InputEvent e)
	{
		let hud = DeltaHud(statusBar);
		if (!hud)
			return false;
		
		hud.TakeInput(e);
		return false;
	}
	
	virtual void PlayerGrazed(GrazeEvent e)
	{
		if (e.thing == e.grazeSource)
			return;
		
		EventHandler.SendInterfaceEvent(e.thing.PlayerNumber(),
			"DeltaPlayerGraze", e.grazeSource ? e.grazeSource.GetNetworkID() : 0);
	}
	
	clearscope int GetCurrentTime()
	{
		return currentTime;
	}
}

class DeltaForceClass : EventHandler
{
	class<DeltaPlayer> targetPlayer;
	
	override void OnRegister()
	{
		targetPlayer = GetPlayerClass();
		if (!targetPlayer)
			ThrowAbortException("%s uses null player class!", GetClassName());
		if (!(targetPlayer is "PlayerPawn"))
			ThrowAbortException("%s uses invalid player class %s!", GetClassName(),
				targetPlayer.GetClassName());
		
		//Console.Printf("target player class is " .. targetPlayer.GetClassName());
	}
	
	override void PlayerEntered(PlayerEvent e)
	{
		let ply = players[e.playerNumber];
		
		if (!ply.mo || ply.cls == targetPlayer)
			return;
		
		let newPawn = PlayerPawn(Actor.Spawn(targetPlayer, ply.mo.pos)),
			oldPawn = ply.mo;
		newPawn.player = ply;
		ply.cls = targetPlayer;
		ply.mo = newPawn;
		ply.camera = ply.mo;
		oldPawn.Destroy();
	}
	
	virtual class<DeltaPlayer> GetPlayerClass()
	{
		return null;
	}
}

class DeltaForceKris : DeltaForceClass
{
	override class<DeltaPlayer> GetPlayerClass()
	{
		return "KrisPlayer";
	}
}

class DeltaTitleEvents : EventHandler
{
	protected Array<TextureID> _titleBackgrounds;
	private int _curTick, _curFrame, _frameDuration, _fadeDuration;
	
	virtual void SetUpTitles()
	{
		let mapset = DeltaGlobals.GetGlobals().GetMapset(),
			titlePrefix = "DELTATT",
			music = "music/mus_deltaMenu.ogg";
		
		if (mapset ~== "Sunlust")
		{
			titlePrefix = "SNLSTTT";
			music = "D_DM2TTL";
		}
		
		for (int i = 1; i <= 5; i++)
		{
			_titleBackgrounds.Push(TexMan.CheckForTexture(titlePrefix .. i));
		}
		S_ChangeMusic(music, force: true);
	}
	
	override void WorldLoaded(WorldEvent e)
	{
		_frameDuration = 15; // ticks per frame including fade duration
		_fadeDuration = _frameDuration; // ticks to fade between frames
		_curFrame = 0;
		SetUpTitles();
	}
	
	override void WorldTick()
	{
		if (!_titleBackgrounds.Size())
			return;
		
		_curTick++;
		
		if (_curTick != _frameDuration)
			return;
		
		_curTick = 0;
		_curFrame++;
		
		if (_curFrame == _titleBackgrounds.Size())
			_curFrame = 0;
	}
	
	override void RenderOverlay(RenderEvent e)
	{
		if (!_titleBackgrounds.Size())
			return;
		
		Screen.DrawTexture(_titleBackgrounds[_curFrame], false, 0, 0,
			DTA_Fullscreen, true, DTA_FullScreenScale, FSMode_ScaleToFill);
		
		if (!_fadeDuration) // make sure we're not dividing by zero
			return;
		
		int nextFrame = _curFrame == _titleBackgrounds.Size()-1 ? 0
			: _curFrame+1;
		double targetAlpha = max(0,
			(_fadeDuration - _frameDuration + _curTick + 1.) / _fadeDuration);
		
		Screen.DrawTexture(_titleBackgrounds[nextFrame], false, 0, 0,
			DTA_Fullscreen, true, DTA_FullScreenScale, FSMode_ScaleToFill,
			DTA_Alpha, targetAlpha);
	}
}