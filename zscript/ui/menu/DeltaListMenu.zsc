class DeltaListMenu : ListMenu
{
	protected string debugString;
	protected int oldSelect;
	protected int selectSoundTimer;
	
	const SOUND_TIMER_SET = 2;
	
	override void Init(Menu parent, ListMenuDescriptor desc)
	{
		Super.Init(parent, desc);
		oldSelect = desc.mSelectedItem;
	}
	
	override void Ticker()
	{
		Super.Ticker();
		
		int index = mDesc.mSelectedItem;
		
		if (index == -1 || selectSoundTimer)
		{
			if (selectSoundTimer)
				selectSoundTimer--;
			
			oldSelect = index;
			return;
		}
		
		if (index == oldSelect)
			return;
		
		MenuSound("delta/menu_change");
		selectSoundTimer = SOUND_TIMER_SET;
		oldSelect = index;
	}
	
	override void Drawer()
	{
		Super.Drawer();
		
		if (mDesc.mMenuName != "MainMenu")
			return;
		
		let str = StringTable.Localize("$DELTAWARRIORS_VERSION"),
			sc = 2.,
			x = Screen.GetWidth() - smallFont.StringWidth(str)*sc - 10,
			y = Screen.GetHeight() - smallFont.GetHeight()*sc - 10;
		
		Screen.DrawText(smallFont, Font.CR_UNTRANSLATED, x, y, str,
			DTA_ScaleX, sc, DTA_ScaleY, sc);
	}
}