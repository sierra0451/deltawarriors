class DeltaOptionMenu : OptionMenu
{
	protected string debugString;
	protected int oldSelect;
	protected int selectSoundTimer;
	
	const SOUND_TIMER_SET = 2;
	
	override void Init(Menu parent, OptionMenuDescriptor desc)
	{
		desc.mFont = smallFont;
		//desc.mTooltipFont = smallFont;
		Super.Init(parent, desc);
		oldSelect = desc.mSelectedItem;
	}
	
	override void Ticker()
	{
		Super.Ticker();
		
		int index = mDesc.mSelectedItem;
		
		if (index == -1 || selectSoundTimer)
		{
			if (selectSoundTimer)
				selectSoundTimer--;
			
			oldSelect = index;
			return;
		}
		if (index == oldSelect)
			return;
		
		MenuSound("delta/menu_change");
		selectSoundTimer = SOUND_TIMER_SET;
		oldSelect = index;
	}
}