class DeltaBerserk : DeltaHealthPickup replaces Berserk
{
	Default
	{
		Health -100;
		Tag "$TAG_BERSERK";
		
		Inventory.MaxAmount 1;
		Inventory.Icon "PSTRA0";
		Inventory.UseSound "delta/use_powerup";
		Inventory.PickupMessage "$GOTBERSERK";
		DeltaHealthPickup.UseMessage "$DELTA_USE_BERSERK";
		DeltaHealthPickup.AlwaysAllowUse true;
		
		+COUNTITEM;
		+Inventory.ISHEALTH;
	}
	
	States
	{
		Spawn:
			PSTR A -1 Bright;
			Stop;
	}
	
	override bool Use(bool pickup)
	{
		if (!Super.Use(pickup))
			return false;
		
		owner.GiveInventory("PowerStrength", 1);
		if (!owner.player)
			return true;
		
		let meleeWeap = owner.player.weapons.GetWeapon(1, 0);
		if (!meleeWeap)
			return true;
		
		let targetWeap = Weapon(owner.FindInventory(meleeWeap, false));
		if (!targetWeap || owner.player.ReadyWeapon == targetWeap)
			return true;
		
		owner.player.PendingWeapon = Weapon(owner.FindInventory(meleeWeap, false));
		return true;
	}
}