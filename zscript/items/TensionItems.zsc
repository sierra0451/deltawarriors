/// base class for tension items!
class DeltaTensionPickup : Inventory
{
	override bool TryPickup(in out Actor toucher)
	{
		let delta = DeltaPlayer(toucher);
		if (!delta)
			return false;
		if (delta.GetTension(delta.maxTensionPoints) != DeltaPlayer.TP_FAIL && !bAlwaysPickup)
			return false;
		
		let actualAmount = (amount < 0)? (amount * -delta.maxTensionPoints/100.) : amount;
		delta.AddTension(actualAmount);
		GoAwayAndDie();
		return true;
	}
}

class DeltaCourage : DeltaTensionPickup replaces ArmorBonus
{
	Default
	{
		Inventory.Amount -5; // 5% i.e. 12.5 TP, not actually 5 TP
		Inventory.PickupMessage "$PICKUP_DELTA_COURAGE";
		
		+COUNTITEM
		+Inventory.ALWAYSPICKUP
	}
	
	States
	{
		Spawn:
			DTNC ABCB 8;
			Loop;
	}
}

class DeltaTensionBit : DeltaTensionPickup
{
	Default
	{
		Tag "$TAG_DELTA_TPSMALL";
		Inventory.Amount -32; // 32% i.e. 80 TP, not actually 32 TP
		Inventory.PickupMessage "$PICKUP_DELTA_TPSMALL";
	}
	
	States
	{
		Spawn:
			DTNB ABCB 8;
			Loop;
	}
}

