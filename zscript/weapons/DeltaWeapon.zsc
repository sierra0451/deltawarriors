class DeltaWeapon : Weapon
{
	protected DeltaWeaponAnimType _animType;	// used to determine if third person sprite uses melee, gun, or magic animations when holding this weapon
	protected double _redCrosshairRange;		// maximum distance an enemy can be at from player and still have red crosshairs when aimed at
	protected double _maxLungeDistance;			// maximum distance the lunge check will detect targets from
	protected double _stopLungeDistance;		// distance user must be at during lunge before they stop and attack
	protected string _altFireIcon;				// used for displaying alt fire key and cost (keep as null if you don't want anything there)
	protected string _crosshair;
    protected bool _atEase;
	protected bool _hasBeenPickedUp;			// used to determine if we should do inspect animation upon pulling this out or not
	protected int _easeTics;
	
	protected double _tensionUse, _tensionUse2;
	protected sound _dryFireSound;
	
	protected state _AtEaseLoopState, _DeselectAtEaseState;
	
	private bool _lungeReadyToStop;
	private TextureID _altFireIconId, _crosshairId;
	
	const EASE_TICS_SET_ATTACK = -25;
	const TP_FAIL_SOUND = "delta/tp_fail";
	
	property AnimType: _animType;
	property RedCrosshairRange: _redCrosshairRange;
	property MaxLungeDistance: _maxLungeDistance;
	property StopLungeDistance: _stopLungeDistance;
	property TensionUse: _tensionUse;
	property TensionUse2: _tensionUse2;
	property AltFireIcon: _altFireIcon;
	property Crosshair: _crosshair;
	property DryFireSound: _dryFireSound;
	
	Default
	{
		Weapon.BobStyle "Smooth";
		Weapon.BobRangeX 0.667;
		Weapon.BobRangeY 0.667;
		Weapon.BobSpeed 2.75;
		DeltaWeapon.AnimType DELTA_WEAPONANIM_GUN;
		DeltaWeapon.RedCrosshairRange PLAYERMISSILERANGE / 2.;
		DeltaWeapon.MaxLungeDistance -1;
		DeltaWeapon.StopLungeDistance 5;
		DeltaWeapon.TensionUse 0;
		DeltaWeapon.TensionUse2 0;
		DeltaWeapon.DryFireSound "delta/dry_fire";
	}
	
	States
	{
		AtEaseLoop:
			TNT1 A 1 A_DeltaWeaponReady(atEase: true);
			Loop;
		OffhandStart:
			TNT1 A 1 A_StartOffhand;
		OffhandLoop:
			TNT1 A 1 A_CheckOffhand;
			Wait;
	}
	
	override void BeginPlay()
	{
		Super.BeginPlay();
		_altFireIconId = TexMan.CheckForTexture(_altFireIcon);
		_crosshairId = TexMan.CheckForTexture(_crosshair);
		
		_AtEaseLoopState = ResolveState("AtEaseLoop");
		_DeselectAtEaseState = ResolveState("DeselectAtEase");
	}
	
	override bool CheckAmmo(int fireMode, bool autoSwitch, bool requireAmmo,
		int ammoCount)
	{
		if (!owner || sv_infiniteammo || (owner.FindInventory('PowerInfiniteAmmo', true) != null))
			return true;
		
		if (!(owner is "DeltaPlayer"))
		{
			if (autoSwitch)
				PlayerPawn(owner).PickNewWeapon(null);
			
			return false;
		}
		
		let hasAltFire = FindState('AltFire') != null;
		
		if (fireMode == EitherFire)
		{
			bool gotBoth = CheckAmmo(PrimaryFire, false)
				|| (hasAltFire && CheckAmmo(AltFire, false));
			
			if (!gotBoth && autoSwitch)
				PlayerPawn(Owner).PickNewWeapon (null);
			
			return gotBoth;
		}
		
		let altFire = (fireMode == AltFire);
		let optional = (altFire? bAlt_Ammo_Optional : bAmmo_Optional);
		let useBoth = (altFire? bAlt_Uses_Both : bPrimary_Uses_Both);

		if (!requireAmmo && optional)
			return true;
		
		int lAmmoUse1,
			lAmmoUse2 = AmmoUse2,
			count1 = ((Ammo1 != null) ? Ammo1.Amount : 0),
			count2 = ((Ammo2 != null) ? Ammo2.Amount : 0);
		double lTensionUse1,
			lTensionUse2 = _tensionUse2,
			tensionCount = DeltaPlayer(owner).tensionPoints;

		if (bDehAmmo && Ammo1 == null)
			lAmmoUse1 = lTensionUse1 = 0;
		else if (ammoCount >= 0)
			lAmmoUse1 = lAmmoUse2 = ammoCount;
		else
		{
			lAmmoUse1 = AmmoUse1;
			lTensionUse1 = _tensionUse;
		}

		int enough = (count1 >= lAmmoUse1 && tensionCount >= lTensionUse1)
			| ((hasAltFire && count2 >= lAmmoUse2 && tensionCount >= lTensionUse2) << 1),
		enoughMask = useBoth ? 3 : (1 << altFire);
		int failEffect = 0; // 0 = none, 1 = dry fire, 2 = tp fail sound
		
		if (altFire ? (count2 < lAmmoUse2) : (count1 < lAmmoUse1))
			failEffect = 1;
		else if (tensionCount < (altFire ? lTensionUse2 : lTensionUse1))
			failEffect = 2;
		
		if ((altFire && !hasAltFire) ||
			((enough & enoughMask) != enoughMask) && !(enough && bAmmo_CheckBoth))
		{
			// out of ammo, pick a weapon to change to
			if (autoSwitch && enough != (1 << !altFire))
				PlayerPawn(Owner).PickNewWeapon (null);
			
			if (autoSwitch && (owner.player.weaponState & (altFire ? WF_WEAPONREADYALT : WF_WEAPONREADY)))
			{
				sound snd = _dryFireSound;
				if (failEffect == 2)
					snd = TP_FAIL_SOUND;
				
				owner.A_StartSound(snd, CHAN_AUTO, CHANF_LOCAL | CHANF_NOSTOP);
			}
			return false;
		}
		
		return true;
	}
	
	override bool DepleteAmmo(bool altFire, bool checkEnough, int ammoUse, bool forceAmmoUse)
	{
		if (!Super.DepleteAmmo(altFire, checkEnough, ammoUse, forceAmmoUse))
			return false;
		if (!checkEnough || TakeTension(altFire))
			return true;
		
		return false;
	}
	
	override state GetUpState()
	{
		if (_hasBeenPickedUp)
			return Super.GetUpState();
		
		_hasBeenPickedUp = true;
		
		let dest = FindState("SelectFirst");
		if (dest)
			return dest;
		
		return Super.GetUpState();
	}
	
	override state GetDownState()
	{
		let psp = owner.player.GetPSprite(PSP_WEAPON);
		if (!psp || !psp.curState.InStateSequence(_AtEaseLoopState))
			return Super.GetDownState();
		
		let dest = FindState("DeselectAtEase");
		if (dest)
			return dest;
		
		return Super.GetDownState();
	}
	
	virtual bool TakeTension(bool altFire)
	{
		let deltaOwner = DeltaPlayer(owner);
		double amount = altFire ? _tensionUse2 : _tensionUse;
		
		if (amount < 0 || !deltaOwner)
			return false;
		if (amount == 0)
			return true;
		
		return deltaOwner.TryTakeTension(amount);
	}
	
	action void A_ResetAtEase()
	{
		invoker._atEase = false;
		invoker._easeTics = invoker.EASE_TICS_SET_ATTACK;
	}
	
	action void A_OwnerPlayAttack(bool muzzleFlash = true)
	{
		let ply = PlayerPawn(invoker.owner);
		
		if (!ply)
			return;
		
		if (muzzleFlash)
			ply.PlayAttacking();
		else
			ply.PlayAttacking2();
	}
	
	action void A_StartRaiseWeapon()
	{
		// some code taken from A_Raise code: https://github.com/UZDoom/UZDoom/blob/41ca20c1c30decbe70da21505785fbec6bb83cd6/wadsrc/static/zscript/actors/inventory/weapons.zs#L307
		if (player == null)
			return;
		if (player.PendingWeapon != WP_NOCHANGE)
		{
			player.mo.DropWeapon();
			return;
		}
		if (player.ReadyWeapon == null)
			return;
		
		let psp = player.GetPSprite(PSP_WEAPON);
		
		if (!psp)
			return;
		
		invoker._atEase = false;
		A_SetCrosshair(-1);
		
		// set weapon sprite upfront immediately, we want to do our own deploy animations
		psp.y = WEAPONTOP;
	}
	
	action void A_FinishRaiseWeapon()
	{
		let psp = player.GetPSprite(PSP_WEAPON);
		
		if (!psp)
			return;
		
		psp.SetState(player.ReadyWeapon.GetReadyState());
	}
	
	action state A_DeltaWeaponReady(int flags = 0, bool atEase = false,
		bool allowOffhand = true)
	{
		let ply = DeltaPlayer(invoker.owner);
		
        if (allowOffhand && (player.cmd.buttons & BT_USER1)
			&& !ply.GetIsUsingOffhand() && ply.TryStartOffhand())
		{
			A_ResetAtEase();
			return ResolveState("OffhandStart");
		}
        
		A_WeaponReady(flags);
		
        if (flags & WRF_NOBOB || (ply && ply.GetIsUsingOffhand()))
			return ResolveState(null);
		
		let iter = ThinkerIterator.Create("DeltaWeaponsAtEase");
		invoker._atEase = iter.Next();
		
		// if our at ease state is not changing, don't do anything
		if (invoker._atEase == atEase)
		{
			if (invoker._easeTics < 0)
				invoker._easeTics++;
			
			return ResolveState(null);
		}
		
        if (invoker._atEase)
		{
			invoker._easeTics++;
			
			if (invoker._easeTics > 0)
				return ResolveState("AtEase");
		}
		else
		{
			let endEase = ResolveState("AtEaseEnd");
			if (endEase)
				return endEase;
			
			return ResolveState("Select");
		}
		
        return ResolveState(null);
	}
	
	action void A_SwapWeapon()
	{
		// some code taken from A_Lower code:
		// https://github.com/UZDoom/UZDoom/blob/41ca20c1c30decbe70da21505785fbec6bb83cd6/wadsrc/static/zscript/actors/inventory/weapons.zs#L259
		if (player == null)
			return;
		if (player.ReadyWeapon == null)
			return;
		
		let psp = player.GetPSprite(PSP_WEAPON);
		if (!psp)
			return;
		
		A_ClearDynamicLights();
		ResetPSprite(psp);
		player.mo.BringUpWeapon();
	}
	
	action state A_DoLunge(state attackState)
	{
		let deltaOwner = DeltaPlayer(self);
		if (!deltaOwner || !deltaOwner.CanLunge()
			|| invoker._lungeReadyToStop || (player.cmd.buttons & BT_BACK))
		{
			invoker._lungeReadyToStop = false;
			
			A_OwnerPlayAttack();
			return attackState;
		}
		
		if (!deltaOwner.IsLunging())
		{
			Actor currMo, targetMo;
			double shortestDistance = invoker._maxLungeDistance + self.radius;
			
			let iter = BlockThingsIterator.Create(deltaOwner, shortestDistance);
			
			while (iter.Next())
			{
				currMo = iter.thing;
				
				if (!currMo || (currMo.health <= 0)
					|| (!currMo.bIsMonster && !(currMo is "PlayerPawn"))
					|| invoker.owner.IsFriend(currMo)
					|| currMo.bNeverTarget) continue;
				
				Vector3 diff = level.Vec3Diff(pos, currMo.pos);
				Vector3 diffNorm = diff.Unit();
				double targetAngle = VectorAngle(diff.x, diff.y);
				double targetPitch = asin(diffNorm.z);
				double distance = diff.Length();
				let forward = DeltaUtil.GetActorForward(deltaOwner, false);
				let diffDot = (diff.x, diff.y).Unit() dot (forward.x, forward.y);
				if (diffDot < 0.9)
					continue;
				
				if (abs(targetPitch) > 80)
					continue;
				
				if (distance <= shortestDistance)
				{
					shortestDistance = distance;
					targetMo = currMo;
				}
				
				if (shortestDistance <= invoker._stopLungeDistance)
					return attackState;
			}
			
			// skip lunge and immediately attack if we don't have a target
			// or if our target is a charging lost soul or equivalent
			// (i.e. if lunging at them would end up hurting us)
			if (!targetMo)
				return attackState;
			if (targetMo.bSkullfly)
				return attackState;
			
			deltaOwner.StartLunge(targetMo, invoker._stopLungeDistance);
		}
		
		if (invoker._lungeReadyToStop)
		{
			invoker._lungeReadyToStop = false;
			return attackState;
		}
		
		return ResolveState(null);
	}
	
	action void A_OwnerKnockback(double groundKnockback, double airKnockback,
		bool crouchNullifies = true)
	{
		double kb = player.onGround ? groundKnockback : airKnockback;
		
		if (crouchNullifies && player.crouchOffset != 0)
			return;
		if (kb ~== 0)
			return;
		
		let kbVec = DeltaUtil.GetActorForward(player.mo) * kb;
		player.mo.vel -= kbVec;
	}
	
	action void A_StartOffhand()
	{
		
	}
	
	action state A_CheckOffHand(bool bob = false, statelabel dest = "Select")
	{
		let deltaOwner = DeltaPlayer(invoker.owner);
		
		if (deltaOwner.GetIsUsingOffhand())
			return ResolveState(null);
		if (deltaOwner.player.PendingWeapon == WP_NOCHANGE)
			return ResolveState(dest);
		
		A_SwapWeapon();
		return ResolveState(null);
	}
	
	action void A_AddRecoil(int startTime, int leadInTime = 0, double p = 0, double y = 0, double r = 0)
	{
		DeltaPlayer(invoker.owner).AddRecoil(RECOIL_WEAPON, startTime, leadInTime, p, y, r);
	}
	
	action void A_AddDynamicLight(Name lightId, Name lightDef)
	{
		let deltaPly = DeltaPlayer(invoker.owner);
		
		if (!deltaPly)
			return;
		
		deltaPly.A_AddDynamicLight(lightId, lightDef);
	}
	
	action void A_RemoveDynamicLight(Name lightId)
	{
		let deltaPly = DeltaPlayer(invoker.owner);
		
		if (!deltaPly)
			return;
		
		deltaPly.A_RemoveDynamicLight(lightId);
	}
	
	action void A_ClearDynamicLights()
	{
		let deltaPly = DeltaPlayer(invoker.owner);
		
		if (!deltaPly)
			return;
		
		deltaPly.A_ClearDynamicLights();
	}
	
	void MarkReadyToStopLunging()
	{
		_lungeReadyToStop = true;
	}
	
	void ResetReadyToStopLunging()
	{
 		_lungeReadyToStop = false;
	}
	
	clearscope float GetRedCrosshairRange()
	{
		return _redCrosshairRange;
	}
	
	clearscope DeltaWeaponAnimType GetAnimType()
	{
		return _animType;
	}
	
	clearscope bool GetAtEase()
	{
		if (!owner || !owner.player)
			return false;
		
		let psp = owner.player.FindPSprite(PSP_WEAPON);
		if (!psp)
			return false;
		
		return InStateSequence(psp.curState, _AtEaseLoopState)
			|| InStateSequence(psp.curState, _DeselectAtEaseState);
	}
	
	clearscope double GetCrouchFactor()
	{
		if (!player || !player.mo)
			return -1;
		if (player.mo is "DeltaPlayer")
			return DeltaPlayer(player.mo).GetCrouchFactor();
		
		return -1;
	}
	
	ui TextureID GetAltFireIcon()
	{
		return _altFireIconId;
	}
	
	ui TextureID GetCrosshair()
	{
		return _crosshairId;
	}
}

// Dummy object meant to make DeltaWarriors players put their weapons to the side
// (i.e. they wouldn't have their weapons drawn in, say, Castle Town)
class DeltaWeaponsAtEase : Actor {}