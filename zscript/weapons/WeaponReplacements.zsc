class PistolReplacer : Inventory replaces Pistol
{
	States
	{
		Spawn:
			TNT1 A 0 NoDelay
			{
				Spawn("KrisRevolver", pos);
				GoAwayAndDie();
			}
			Stop;
	}
}

class ShotgunReplacer : Inventory replaces Shotgun
