// Dynamic lights
pointlight DeltaGenericMuzzle
{
	color 1 0.4 0
	size 32
	offset 0 24 0
	dontlightself 1
}

pointlight DeltaRevolverChargeShotMuzzle
{
	color 1 1 0
	size 48
	offset 0 24 0
	dontlightself 1
}

pointlight DeltaRevolverCharge1
{
	color 0.25 0.25 0
	size 8
	offset 0 24 0
	dontlightself 1
}

pointlight DeltaRevolverCharge2
{
	color 0.5 0.5 0
	size 16
	offset 0 24 0
	dontlightself 1
}

pointlight DeltaRevolverCharge3
{
	color 0.75 0.75 0
	size 24
	offset 0 24 0
	dontlightself 1
}

pointlight DeltaRevolverChargeFull
{
	color 1 1 0
	size 32
	offset 0 24 0
	dontlightself 1
}

pointlight DeltaCourageLight
{
	color 1 0.625 0.25
	size 8
}

pointlight DeltaTensionGemLight
{
	color 1 0.625 0.25
	size 16
}

pointlight DeltaTensionMaxLight
{
	color 1 0.625 0.25
	size 24
}

object DeltaCourage
{
	frame DTNC { light DeltaCourageLight }
}

object DeltaTensionGem
{
	frame DTNG { light DeltaTensionGemLight }
}

object DeltaTensionMax
{
	frame DTNM { light DeltaTensionMaxLight }
}